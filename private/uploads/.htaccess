<IfModule mod_php7.c>
    php_flag engine off
</IfModule>
<FilesMatch "\.(php|phtml|php3|php4|php5|phar)$">
    Require all denied
</FilesMatch>

<FilesMatch "\.(jpg|jpeg|png|gif|webp|svg)$">
    Require all granted
</FilesMatch>
<FilesMatch "!(jpg|jpeg|png|gif|webp|svg)$">
    Require all denied
</FilesMatch>

<IfModule mod_headers.c>
    Header set Cache-Control "no-cache, must-revalidate"
    Header unset Expires
</IfModule>